{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheNigmaDataBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME"
    },
    {
      "Sid": "ReadWriteMediaAndDatabaseObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME/uploads/*",
        "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME/db/*"
      ]
    }
  ]
}
