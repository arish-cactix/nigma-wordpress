# Non-secret settings for the NIGMA Docker runtime (ADR-016).
#
# The bootstrap creates /etc/nigma/.env from this file on first run (mode 600,
# root only) and GENERATES the database passwords. Never commit a real .env.

COMPOSE_PROJECT_NAME=nigma
TZ=UTC

# ---- site -------------------------------------------------------------------
# Comma-separated hostnames served by this host. The first one starting with
# "www." (else the first) is used for health checks.
SITE_DOMAINS=nigma.ae,www.nigma.ae
# Name of the certificate lineage under /etc/letsencrypt/live/
CERT_NAME=nigma-ae
# Optional contact email for Let's Encrypt (empty = register without an email).
ACME_EMAIL=
# 1 = use the Let's Encrypt STAGING environment (untrusted certs, no rate limits). Use for tests.
ACME_STAGING=0

# ---- code -------------------------------------------------------------------
GIT_REPO=https://github.com/arish-cactix/nigma-wordpress.git
GIT_BRANCH=main
# WordPress core is not in git; the bootstrap installs and checksum-verifies this version.
WP_VERSION=7.1.4
# Must match the table prefix of the database being restored.
TABLE_PREFIX=ngm_

# ---- database (passwords are generated on first bootstrap) -------------------
DB_NAME=nigma_live
DB_USER=nigma_wp
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_BUFFER_POOL=256M

# ---- media library and backups (private S3 bucket, see docker/prod/README.md) -
# Where the media library lives. Empty = do not restore/back up media.
#   example: s3://nigma-media-123456789012/uploads
MEDIA_S3_URI=
# Where database dumps live (db/latest.sql.gz is restored when the database is empty).
#   example: s3://nigma-media-123456789012/db
DB_BACKUP_S3_URI=
# 1 = install a daily timer that backs up media and the database to S3.
BACKUP_TIMER=0

# ---- host user and ports (rarely changed) -----------------------------------
CODE_USER=ubuntu
HTTP_PORT=80
HTTPS_PORT=443
